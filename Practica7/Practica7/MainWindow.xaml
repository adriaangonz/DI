<Window x:Class="Practica7.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Practica7"
        mc:Ignorable="d"
        Title="Gestión de pedidos de cafetería" Height="520" Width="850"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- FORMULARIO DE REGISTRO -->
        <GroupBox Header="Nuevo Pedido" Grid.Column="0" Margin="0,0,12,0" Padding="10">
            <StackPanel>
                <TextBlock Text="Nombre del cliente:" Margin="0,0,0,3"/>
                <TextBox x:Name="txtCliente" Height="24" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                <TextBlock Text="Producto:" Margin="0,0,0,3"/>
                <ComboBox x:Name="cmbProducto" Height="24" VerticalContentAlignment="Center" Margin="0,0,0,10">
                    <ComboBoxItem Content="Café"/>
                    <ComboBoxItem Content="Té"/>
                    <ComboBoxItem Content="Bocadillo"/>
                    <ComboBoxItem Content="Repostería"/>
                </ComboBox>

                <TextBlock Text="Cantidad:" Margin="0,0,0,3"/>
                <TextBox x:Name="txtCantidad" Height="24" VerticalContentAlignment="Center" Margin="0,0,0,10" Text="1"/>

                <TextBlock Text="Tipo de recogida:" Margin="0,0,0,3"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <RadioButton x:Name="rbEnLocal" GroupName="TipoRecogida" Content="En local" IsChecked="True" Margin="0,0,15,0"/>
                    <RadioButton x:Name="rbParaLlevar" GroupName="TipoRecogida" Content="Para llevar"/>
                </StackPanel>

                <TextBlock Text="Observaciones:" Margin="0,0,0,3"/>
                <TextBox x:Name="txtObservaciones" Height="65" TextWrapping="Wrap" AcceptsReturn="True" 
                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,15"/>

                <Button x:Name="btnRegistrar" Content="Registrar pedido" Height="32" FontWeight="SemiBold" Click="BtnRegistrar_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- LISTADOS DE PEDIDOS -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- PEDIDOS PENDIENTES -->
            <GroupBox Grid.Row="0" Margin="0,0,0,6">
                <GroupBox.Header>
                    <TextBlock x:Name="tbContadorPendientes" Text="Pedidos pendientes (0)" FontWeight="Bold"/>
                </GroupBox.Header>
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListView x:Name="lvPendientes" Grid.Row="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Cliente" DisplayMemberBinding="{Binding Cliente}" Width="140"/>
                                <GridViewColumn Header="Producto" DisplayMemberBinding="{Binding Producto}" Width="100"/>
                                <GridViewColumn Header="Cantidad" DisplayMemberBinding="{Binding Cantidad}" Width="65"/>
                                <GridViewColumn Header="Recogida" DisplayMemberBinding="{Binding TipoRecogida}" Width="100"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <Button x:Name="btnPreparar" Grid.Row="1" Content="Preparar pedido" Height="28" Width="140" 
                            HorizontalAlignment="Right" Margin="0,6,0,0" Click="BtnPreparar_Click"/>
                </Grid>
            </GroupBox>

            <!-- PEDIDOS PREPARADOS -->
            <GroupBox Grid.Row="1" Margin="0,6,0,0">
                <GroupBox.Header>
                    <TextBlock x:Name="tbContadorPreparados" Text="Pedidos preparados (0)" FontWeight="Bold"/>
                </GroupBox.Header>
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListView x:Name="lvPreparados" Grid.Row="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Cliente" DisplayMemberBinding="{Binding Cliente}" Width="140"/>
                                <GridViewColumn Header="Producto" DisplayMemberBinding="{Binding Producto}" Width="100"/>
                                <GridViewColumn Header="Cantidad" DisplayMemberBinding="{Binding Cantidad}" Width="65"/>
                                <GridViewColumn Header="Recogida" DisplayMemberBinding="{Binding TipoRecogida}" Width="100"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <Button x:Name="btnDevolver" Grid.Row="1" Content="Devolver a pendientes" Height="28" Width="160" 
                            HorizontalAlignment="Right" Margin="0,6,0,0" Click="BtnDevolver_Click"/>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
