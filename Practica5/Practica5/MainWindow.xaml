<Window x:Class="Practica5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Practica5"
        mc:Ignorable="d"
        Title="Gestión de incidencias técnicas" Height="480" Width="820"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- FORMULARIO DE REGISTRO -->
            <GroupBox Header="Nueva incidencia" Grid.Column="0" Margin="0,0,6,0" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Título:" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtTitulo" Grid.Row="0" Grid.Column="1" Height="24" VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Categoría:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cbCategoria" Grid.Row="1" Grid.Column="1" Height="24" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Hardware"/>
                        <ComboBoxItem Content="Software"/>
                        <ComboBoxItem Content="Red"/>
                        <ComboBoxItem Content="Otros"/>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Prioridad:" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="rbBaja" GroupName="Prioridad" Content="Baja" Margin="0,0,15,0"/>
                        <RadioButton x:Name="rbMedia" GroupName="Prioridad" Content="Media" IsChecked="True" Margin="0,0,15,0"/>
                        <RadioButton x:Name="rbAlta" GroupName="Prioridad" Content="Alta"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Tiempo estimado:" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="txtTiempo" Width="80" Height="24" VerticalContentAlignment="Center"/>
                        <TextBlock Text="minutos" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- ACCIONES -->
            <GroupBox Header="Acciones" Grid.Column="1" Margin="6,0,0,0" Padding="15">
                <StackPanel VerticalAlignment="Center">
                    <Button x:Name="btnRegistrar" Content="Registrar incidencia" Height="30" Margin="0,0,0,10" Click="BtnRegistrar_Click"/>
                    <Button x:Name="btnGestionar" Content="Gestionar incidencia" Height="30" Margin="0,0,0,10" Click="BtnGestionar_Click"/>
                    <Button x:Name="btnLimpiar" Content="Limpiar" Height="30" Margin="0,0,0,15" Click="BtnLimpiar_Click"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Incidencias registradas: " FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="lblContador" Text="0" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- LISTADO DE INCIDENCIAS -->
        <GroupBox Header="Incidencias registradas" Grid.Row="1" Margin="0,5,0,0" Padding="5">
            <ListView x:Name="lvIncidencias">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Título" Width="200" DisplayMemberBinding="{Binding Titulo}"/>
                        <GridViewColumn Header="Categoría" Width="120" DisplayMemberBinding="{Binding Categoria}"/>
                        <GridViewColumn Header="Prioridad" Width="100" DisplayMemberBinding="{Binding Prioridad}"/>
                        <GridViewColumn Header="Tiempo (min)" Width="100" DisplayMemberBinding="{Binding Tiempo}"/>
                        <GridViewColumn Header="Estado" Width="120" DisplayMemberBinding="{Binding Estado}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>
    </Grid>
</Window>
